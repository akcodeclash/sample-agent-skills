# Names only. These are secret keys in the client's Bitwarden Secrets Manager
# project. start.sh reads them through `bws run`; do not put values in a file.
TENANT_ID=               # Microsoft Entra directory (tenant) ID
CLIENT_ID=               # App registration application (client) ID
CERT_PATH=               # Absolute path to the client's .pfx on this machine
CERT_PASSPHRASE=         # Passphrase for the .pfx

# Optional. Without it, set_permissions treats every address as external.
TENANT_DOMAINS=          # Comma-separated tenant email domains, e.g. contoso.com,contoso.onmicrosoft.com

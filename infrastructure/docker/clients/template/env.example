# ─────────────────────────────────────────────────────────────
# Client Environment Config
# Copy this to .env and fill in values.
# Never commit .env — only commit .env.example
# ─────────────────────────────────────────────────────────────

# Client identifier — used for container/volume naming
# Use lowercase, hyphens only (e.g. acme-corp, smith-retail)
CLIENT_NAME=your-client-name

# ── PostgreSQL ────────────────────────────────────────────────
# Port: start at 5433 for first client, increment by 10 each client
# (5432 reserved, 5433 = client 1, 5443 = client 2, 5453 = client 3)
POSTGRES_PORT=5433
DB_USER=dev
DB_PASSWORD=changeme
DB_NAME=app_dev

# Full connection string (used in your app's .env)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${POSTGRES_PORT}/${DB_NAME}

# ── Redis ─────────────────────────────────────────────────────
# Port: start at 6380 for first client, increment by 10 each client
# (6379 reserved, 6380 = client 1, 6390 = client 2, 6400 = client 3)
REDIS_PORT=6380
REDIS_PASSWORD=changeme

# Full connection string (used in your app's .env)
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:${REDIS_PORT}
